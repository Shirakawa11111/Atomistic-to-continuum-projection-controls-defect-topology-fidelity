# Route A — finite-T MD for R1 time-average density
units           metal
dimension       3
boundary        p p f
atom_style      atomic
read_data       relaxed_T0_pristine.data
pair_style      airebo 3.0 1 1
pair_coeff      * * CH.airebo C
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
velocity        all create 300.0 12345 mom yes rot yes dist gaussian
fix             nvt all nvt temp 300.0 300.0 0.1
thermo          1000
thermo_style    custom step temp pe
timestep        0.0005
run             20000
dump            d1 all custom 2000 md_T0_pristine_*.dump id type x y z
dump_modify     d1 sort id
run             40000
print           "MD_DONE T = 300.0"
